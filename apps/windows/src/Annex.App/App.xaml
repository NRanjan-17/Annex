<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Annex.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Black and white, like the Mac app: the accent (main buttons, switches, focus) is
                 white, and text on it is black. The only colour left is the green "live" dot. -->
            <Color x:Key="SystemAccentColor">#FFF2F2F2</Color>
            <Color x:Key="SystemAccentColorLight1">#FFF2F2F2</Color>
            <Color x:Key="SystemAccentColorLight2">#FFEDEDED</Color>
            <Color x:Key="SystemAccentColorLight3">#FFE6E6E6</Color>
            <Color x:Key="SystemAccentColorDark1">#FFD9D9D9</Color>
            <Color x:Key="SystemAccentColorDark2">#FFBFBFBF</Color>
            <Color x:Key="SystemAccentColorDark3">#FFA6A6A6</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
