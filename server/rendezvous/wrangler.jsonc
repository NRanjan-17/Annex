// Annex rendezvous (see docs/INTERNET-CONNECT.md). Fits the Workers Free plan: SQLite-backed
// Durable Objects, and the waiting host's WebSocket hibernates between messages.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "annex-rendezvous",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // The apps connect to wss://connect.getannex.dev.
  "routes": [{ "pattern": "connect.getannex.dev", "custom_domain": true }],
  "durable_objects": {
    "bindings": [
      { "name": "CODES", "class_name": "CodeRoom" },
      { "name": "LIMITS", "class_name": "Limiter" },
      { "name": "BUDGET", "class_name": "Budget" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CodeRoom", "Limiter"] },
    { "tag": "v2", "new_sqlite_classes": ["Budget"] }
  ],
  // Our relay (Cloudflare TURN). Off unless both secrets are set:
  //   npx wrangler secret put TURN_KEY_ID
  //   npx wrangler secret put TURN_KEY_API_TOKEN
  // Limits: logins a day per sharing computer, and how long each lasts. No total cap: the relay is
  // only the fallback. See README.md.
  "vars": {
    "RELAY_TTL_SECONDS": "86400",
    "RELAY_PER_DEVICE_PER_DAY": "10"
  }
}
